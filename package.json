{
  "name": "jenga-icons",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*",
    "scripts/*",
    "docs"
  ],
  "scripts": {
    "build": "bun run --filter './packages/**' build && bun run --filter './examples/**' --filter 'docs' build",
    "build:react": "bun run generate:react && bun run --filter @jengaicons/react build",
    "build:svelte": "bun run generate:svelte && bun run --filter @jengaicons/svelte build",
    "clean": "bun run --filter '*' clean || true && rm -rf node_modules",
    "generate:optimized": "bun run --filter generate-optimized build",
    "generate:icon-nodes": "bun run --filter generate-icon-nodes build",
    "generate:react": "bun run --filter generate-jengaicons-react build",
    "generate:svelte": "bun run --filter generate-jengaicons-svelte build",
    "release": "bun run build:react && bun run build:svelte && npm publish --workspace=@jengaicons/react && npm publish --workspace=@jengaicons/svelte",
    "release:react": "bun run build:react && npm publish --workspace=@jengaicons/react",
    "release:svelte": "bun run build:svelte && npm publish --workspace=@jengaicons/svelte",
    "test": "bun run --filter '*' test",
    "example:build": "bun run --filter next-ts-app-dir build",
    "example:dev": "bun run --filter next-ts-app-dir dev",
    "example:start": "bun run --filter next-ts-app-dir start",
    "docs:build": "bun run --filter docs build",
    "docs:dev": "bun run --filter docs dev",
    "docs:start": "bun run --filter docs start",
    "format": "bunx pretty-quick --pattern \"**/*.*(js|jsx|ts|tsx)\"",
    "format:staged": "bunx pretty-quick --staged --pattern \"**/*.*(js|jsx|ts|tsx)\""
  },
  "devDependencies": {
    "@size-limit/preset-big-lib": "12.0.0",
    "@size-limit/webpack": "12.0.0",
    "@size-limit/webpack-why": "12.0.0",
    "@svgr/cli": "^8.1.0",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "prettier": "3.8.1",
    "pretty-quick": "4.2.2",
    "size-limit": "12.0.0",
    "typescript": "^5.9.3"
  },
  "size-limit": [
    {
      "name": "@jengaicons/react ESM Build",
      "limit": "3 kb",
      "path": "./packages/jengaicons-react/dist/esm/index.mjs",
      "import": "{ Activity }"
    },
    {
      "name": "@jengaicons/react CJS Build",
      "limit": "3 kb",
      "path": "./packages/jengaicons-react/dist/cjs/index.js",
      "import": "{ Activity }"
    },
    {
      "name": "@jengaicons/svelte Build",
      "limit": "3 kb",
      "path": "./packages/jengaicons-svelte/dist/index.js",
      "import": "{ Activity }"
    }
  ],
  "trustedDependencies": [
    "esbuild"
  ]
}
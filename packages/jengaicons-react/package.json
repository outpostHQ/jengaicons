{
  "name": "@jengaicons/react",
  "version": "1.9.0",
  "keywords": [
    "jenga-icons",
    "react-icons",
    "icons",
    "react",
    "typescript",
    "svg",
    "svg-icons",
    "icon-pack",
    "icon-font"
  ],
  "homepage": "https://github.com/outposthq/jengaicons",
  "bugs": "https://github.com/outposthq/jengaicons",
  "repository": "outposthq/jengaicons",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/@types/index.d.ts",
  "source": "src/index.tsx",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "pnpm --filter generate-jengaicons-react build && cross-env NODE_ENV=production rollup --config rollup.config.mjs && pnpm gen-types",
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf node_modules",
    "gen-types": "tsc"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "16.0.3",
    "@swc/core": "1.15.11",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "cross-env": "10.1.0",
    "generate-jengaicons-react": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rimraf": "6.1.2",
    "rollup": "4.57.1",
    "rollup-plugin-node-externals": "8.1.2",
    "rollup-plugin-progress": "1.1.2",
    "rollup-plugin-summary": "3.0.1",
    "rollup-plugin-swc3": "0.12.1",
    "rollup-swc-preserve-directives": "0.7.0",
    "tslib": "2.8.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": ">=16"
  },
  "publishConfig": {
    "access": "public"
  }
}

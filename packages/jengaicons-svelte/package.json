{
  "name": "@jengaicons/svelte",
  "version": "0.4.0",
  "keywords": [
    "jenga-icons",
    "svelte-icons",
    "icons",
    "svelte",
    "typescript",
    "svg",
    "svg-icons",
    "icon-pack",
    "icon-font"
  ],
  "homepage": "https://github.com/outposthq/jengaicons",
  "bugs": "https://github.com/outposthq/jengaicons",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outposthq/jengaicons.git",
    "directory": "packages/jengaicons-svelte"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.svelte.d.ts",
      "svelte": "./dist/icons/*.js",
      "default": "./dist/icons/*.js"
    }
  },
  "typings": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run --filter generate-jengaicons-svelte build && cross-env NODE_ENV=production rollup --config rollup.config.mjs && node scripts/copy-assets.mjs",
    "clean": "rm -rf dist && rm -rf node_modules",
    "gen-types": "tsc"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "16.0.3",
    "@swc/core": "1.15.11",
    "@types/node": "^25.2.0",
    "cross-env": "10.1.0",
    "rimraf": "6.1.2",
    "rollup": "4.57.1",
    "rollup-plugin-node-externals": "8.1.2",
    "rollup-plugin-progress": "1.1.2",
    "rollup-plugin-summary": "3.0.1",
    "rollup-plugin-swc3": "0.12.1",
    "rollup-swc-preserve-directives": "0.7.0",
    "svelte": "^5.49.1",
    "tslib": "2.8.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}